# Local backend: port 3000. Frontend dev server: http://127.0.0.1:18080
# Existing .env.local and shell VITE_* overrides must use the same backend URL.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_WS_URL=

# Optional override; default comes from the backend stream state
VITE_HLS_URL=

# 1이면 로그인 화면에 데모용 "닉네임으로 참가하기"·"어드민으로 참가하기" 버튼을 보여준다
VITE_DEMO_MODE=
