HOST=127.0.0.1
PORT=3000
REDIS_URL=redis://127.0.0.1:6379/0
# ONAIR_REDIS_URL takes precedence over REDIS_URL when set (same name as engine).
ONAIR_STATION_ID=st_local_dev
# Absolute shared root; default is repository/apps/engine/var/audio.
# ONAIR_AUDIO_DIR=C:/onair-data/audio
ONAIR_HLS_ENABLED=1
# FFmpeg must be installed; an absolute executable path is also supported.
ONAIR_FFMPEG=ffmpeg
# Default output: apps/backend/var/hls
# ONAIR_HLS_DIR=C:/onair-data/hls

# Prototype scheduler policy defaults.
STREAM_BUFFER_TARGET_SECONDS=45
REQUEST_RESPONSE_WINDOW_SECONDS=90
