# Local development/manual tests: backend 3000, frontend 18080, engine REST 8100.
# Shell environment variables override this file; restart after changing settings.
HOST=127.0.0.1
ONAIR_ENGINE_API_URL=http://127.0.0.1:8100
# Must match the engine REST token; not a frontend JWT.
# ONAIR_ENGINE_TOKEN=your-internal-token
PORT=3000
REDIS_URL=redis://127.0.0.1:6379/0
# ONAIR_REDIS_URL takes precedence over REDIS_URL when set (same name as engine).
ONAIR_STATION_ID=st_local_dev
# Absolute shared root; default is repository/apps/engine/var/audio.
# ONAIR_AUDIO_DIR=C:/onair-data/audio
ONAIR_HLS_ENABLED=1
# FFmpeg must be installed; an absolute executable path is also supported.
ONAIR_FFMPEG=ffmpeg
# Default output: apps/backend/var/hls
# ONAIR_HLS_DIR=C:/onair-data/hls
ONAIR_FALLBACK_MODE=music
# Optional original/licensed bed mixed at -15 dB under speech/ack/filler/glue.
# ONAIR_BGM_AUDIO=C:/onair-data/bgm.wav
# Optional local fallback file; otherwise a short original tone melody is generated.
# ONAIR_FALLBACK_AUDIO=C:/onair-data/fallback.wav
ONAIR_BUFFER_LOW_SECONDS=15
# Server broadcast clock offset, not a guarantee of individual listener timing.
ONAIR_BROADCAST_DELAY_SECONDS=12
# Direct YouTube queue MVP: finite videos only, default maximum 10 minutes.
ONAIR_YOUTUBE_MAX_SECONDS=600
# Enable only after the engine supports track events and submits music_ref introductions.
# Default 0 keeps direct music queue playback compatible with the current engine.
ONAIR_TRACK_INTRO_ENABLED=0
# Internal Lavalink service; this password is NOT the Google refresh token.
ONAIR_LAVALINK_URL=http://127.0.0.1:2333
# ONAIR_LAVALINK_PASSWORD=your-internal-password

# Prototype scheduler policy defaults.
STREAM_BUFFER_TARGET_SECONDS=45
REQUEST_RESPONSE_WINDOW_SECONDS=90

# JWT signing secret for /api/auth. The default is dev-only — set a real random
# value (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`) before
# deploying anywhere reachable by anyone but you.
# ONAIR_JWT_SECRET=dev-insecure-secret-change-me
