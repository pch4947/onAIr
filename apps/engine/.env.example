# 엔진 환경변수 — 이 파일을 .env로 복사해 값을 채운다 (.env는 커밋되지 않는다)
# 이미 설정된 OS 환경변수가 .env보다 우선한다 (백엔드와 동일)

# LLM — pipeline.llm(또는 --llm)으로 고른 제공자의 키만 채우면 된다
# openai: 호환 서버(Qwen DashScope 등)는 그 서버의 키, Ollama는 불필요
OPENAI_API_KEY=
# claude
ANTHROPIC_API_KEY=
# gemini
GEMINI_API_KEY=

# TTS — pipeline.tts로 고른 제공자의 키만 채우면 된다 (edge·dummy는 불필요)
# cartesia (팀 결정 운영 TTS)
CARTESIA_API_KEY=
# google
GOOGLE_TTS_API_KEY=

# 전송 — 설정 파일의 transport.redis_url / transport.token보다 우선한다
# ONAIR_REDIS_URL=redis://127.0.0.1:6379/0
# ONAIR_ENGINE_TOKEN=
